CAMERA_SOURCE=rtsp://CAMERA_USER:CAMERA_PASSWORD@CAMERA_IP:554/stream2

POSE_MODEL=mdl/yolo11n-pose_openvino_model
GRU_MODEL=mdl/gru_tapo_blend_095.pt

SMS_ON=false
SMS_PORT=COM6

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
COOKIE_SECURE=false
SESSION_DAYS=7

DB_PATH=data/app.db
IMG_DIR=data/img

POSE_MODEL=mdl/yolo11n-pose_openvino_model
POSE_FALLBACK=yolo11n-pose.pt
POSE_DEVICE=cpu
POSE_IMGSZ=512
POSE_CONF=0.35

GRU_MODEL=mdl/gru.pt
SEQ_LEN=24
INPUT_DIM=92
HIDDEN_DIM=64
GRU_LAYERS=2
SAMPLE_FPS=8
JPEG_QUALITY=0.68
KP_CONF=0.25
MIN_VISIBLE=7
CLEAR_VISIBLE=12
EVENT_THRESHOLD=0.75
CONFIRM_FRAMES=3
REARM_FRAMES=8
COOLDOWN_SECONDS=45
MISSING_RESET_FRAMES=12

# Camera do may chu truc tiep quan ly.
# Webcam USB: CAMERA_SOURCE=0
# Camera IP:   CAMERA_SOURCE=rtsp://user:password@192.168.1.100:554/stream1
CAMERA_SOURCE=0
CAMERA_NAME=Camera 01
CAMERA_BACKEND=auto
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_RECONNECT_SECONDS=3

SMS_ON=false
SMS_PORT=COM5
SMS_BAUD=115200
SMS_TIMEOUT=12
SMS_RETRIES=2
